# Copy to .env and fill in. docker-compose reads these automatically.
#
# Any variable below can instead be supplied via a file using the Docker
# secrets convention: set NAME_FILE to a path and its contents become the
# value (a trailing newline is trimmed). NAME_FILE takes precedence over NAME.
# e.g. RADARR_API_KEY_FILE=/run/secrets/radarr_api_key
PORT=3939
LOG_LEVEL=info

# Shared secret Seerr must present. Leave blank to disable auth.
WEBHOOK_SECRET=change-me

# blocklist-search | search | delete-search
REDOWNLOAD_MODE=blocklist-search

# Comma-separated Seerr issue type ids (1=video 2=audio 3=subtitles 4=other).
# Blank = act on all issue types.
ISSUE_TYPES=

RADARR_URL=http://radarr:7878
RADARR_API_KEY=

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Optional: auto-resolve the Seerr issue once the replacement imports.
# Leave blank for fire-and-forget (no issue resolution).
SEERR_URL=http://seerr:5055
SEERR_API_KEY=
RESOLVE_COMMENT=true
PENDING_TTL_DAYS=7
STATE_FILE=/data/pending.json
